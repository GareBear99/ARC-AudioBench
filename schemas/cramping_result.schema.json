{"$id":"https://github.com/GareBear99/ARC-AudioBench/schemas/cramping_result.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Result of scripts/cramping_test.py: filter response from a log sweep vs the analogue prototype. The headline is the error at the geometric-mean frequency sqrt(fc * sr/2). The RBJ biquad cramps: peaking at fc 8000 loses -2.026 dB there. The FreeEQ8 baseline to beat is -3.383 dB at the geometric-mean frequency.","properties":{"analysis_type":{"const":"cramping_test"},"error_at_fc_db":{"type":"number"},"error_at_geometric_mean_db":{"type":"number"},"error_at_geometric_mean_frequency_hz":{"minimum":0,"type":"number"},"filter":{"properties":{"fc_hz":{"minimum":0,"type":"number"},"gain_db":{"type":["number","null"]},"q":{"minimum":0,"type":"number"},"type":{"enum":["peaking","lowpass","highpass"],"type":"string"}},"required":["type","fc_hz","q"],"type":"object"},"geometric_mean_hz":{"minimum":0,"type":"number"},"input":{"type":"string"},"max_abs_error_db":{"minimum":0,"type":"number"},"max_error_db_threshold":{"type":"number"},"pass":{"type":"boolean"},"points":{"items":{"required":["frequency_hz","digital_mag_db","analogue_mag_db","error_db"],"type":"object"},"type":"array"},"sample_rate_hz":{"minimum":1,"type":"integer"},"schema_version":{"const":"arc-audiobench-cramping-v1"},"sweep":{"type":"object"},"tool":{"const":"ARC-AudioBench"}},"required":["schema_version","tool","analysis_type","input","sample_rate_hz","pass","error_at_geometric_mean_db","max_abs_error_db","points"],"title":"ARC-AudioBench Cramping Test Result","type":"object"}