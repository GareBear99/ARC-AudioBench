{"$id":"https://github.com/GareBear99/ARC-AudioBench/schemas/nmr_result.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Result of scripts/nmr_test.py: noise-to-mask ratio of alias products against the auditory masking curve (Therum paper section 7 headline test). An alias is inaudible when its NMR is below 0 dB. The band-limited sawtooth must pass; the naive sawtooth must fail with worst NMR +36.046 dB.","properties":{"alias_peak_count":{"minimum":0,"type":"integer"},"aliases":{"type":"array"},"analysis_type":{"const":"nmr_test"},"channels":{"minimum":1,"type":"integer"},"fft_size":{"minimum":1,"type":"integer"},"fundamental_dbfs":{"type":"number"},"fundamental_hz":{"minimum":0,"type":"number"},"harmonic_peak_count":{"minimum":0,"type":"integer"},"label":{"type":"string"},"nmr_threshold_db":{"type":"number"},"noise_floor_dbfs":{"type":"number"},"pass":{"type":"boolean"},"reference_note":{"type":"string"},"reference_spl_db":{"type":"number"},"sample_rate":{"minimum":1,"type":"integer"},"schema_version":{"const":"arc-audiobench-nmr-v1"},"source_file":{"type":"string"},"tool":{"const":"ARC-AudioBench"},"tool_version":{"type":"string"},"worst_nmr_db":{"type":["number","null"]},"worst_nmr_hz":{"type":["number","null"]},"worst_nmr_simultaneous_db":{"type":["number","null"]},"worst_nmr_simultaneous_hz":{"type":["number","null"]}},"required":["schema_version","tool","analysis_type","source_file","sample_rate","fundamental_hz","pass","worst_nmr_db","nmr_threshold_db"],"title":"ARC-AudioBench NMR Test Result","type":"object"}