{"$id":"https://github.com/GareBear99/ARC-AudioBench/schemas/stoi_result.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Result of scripts/stoi_test.py: STOI intelligibility (Taal et al. 2011) of a degraded signal vs a clean reference. The TAL-Vocoder bar is 0.7434; the Ghost outputs are judged against it (FreeVox8 Ghost 0.7939, Vox8 Ghost 0.7796). When no --min-stoi threshold is given, pass is null and the result reports the value only.","properties":{"analysis_type":{"const":"stoi_test"},"band_centres_hz":{"type":"array"},"band_means":{"type":"array"},"clean":{"type":"string"},"degraded":{"type":"string"},"duration_s":{"minimum":0,"type":"number"},"frames_kept":{"minimum":0,"type":"integer"},"frames_total":{"minimum":0,"type":"integer"},"min_stoi_threshold":{"type":["number","null"]},"pass":{"type":["boolean","null"]},"sample_rate_hz":{"minimum":1,"type":"integer"},"schema_version":{"const":"arc-audiobench-stoi-v1"},"segments":{"minimum":0,"type":"integer"},"stoi":{"maximum":1,"minimum":0,"type":"number"},"tool":{"const":"ARC-AudioBench"}},"required":["schema_version","tool","analysis_type","clean","degraded","sample_rate_hz","stoi","frames_total","frames_kept"],"title":"ARC-AudioBench STOI Test Result","type":"object"}